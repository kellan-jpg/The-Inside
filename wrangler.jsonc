{
  // IMPORTANT: replace the text below with the exact name of your project in the
  // Cloudflare dashboard (Workers & Pages, then the name shown at the top of your project).
  "name": "The-Inside",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // Your site files live in the public folder. Only /api/ requests run the Worker code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Which Claude model Bludle uses. Check the current names and prices in Anthropic's docs.
  "vars": { "CLAUDE_MODEL": "claude-haiku-5-5" },

  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true }
  }
}
